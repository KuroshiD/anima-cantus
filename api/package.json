{
  "name": "@anima/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/modules/worker/worker.ts",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:completed": "tsx prisma/seed-completed.ts"
  },
  "dependencies": {
    "@anima/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@bull-board/api": "^6.10.1",
    "@bull-board/express": "^6.10.1",
    "@bull-board/nestjs": "^6.10.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.11.1",
    "argon2": "^0.43.0",
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.1",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^4.3.1",
    "nodemailer": "^7.0.4",
    "pdf-lib": "^1.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.32",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "prisma": "^6.11.1",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
